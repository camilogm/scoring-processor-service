# Copy to .env and fill in the one REQUIRED value:  cp example.env .env
# Never commit .env.

# =============================================================================================
# REQUIRED: the model, through Vercel AI Gateway (OpenAI-compatible)
# =============================================================================================
# Create a key at https://vercel.com/ -> AI Gateway -> API Keys. This is the only secret you need.
AI_GATEWAY_API_KEY=your-gateway-key-here

LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
# docker compose ignores LLM_BASE_URL (it is meant for runs outside Docker) and uses this one
# instead. Its default is Ollama on the host, so under Docker this line is what points the api at
# the gateway. Keep both lines equal.
DOCKER_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1

# The pinned model all reported results come from. It needs vision: frames are judged too.
LLM_MODEL=google/gemini-2.5-flash
LLM_VISION=true
# Frames sent to the judge. 16 fits easily in a gateway model's context.
LLM_MAX_FRAMES=16

# =============================================================================================
# OPTIONAL: everything below has a working default
# =============================================================================================

# --- Cost
# With the gateway, cost_usd is the billed cost (looked up per generation). A clip whose judge
# call costs more than this is logged as over budget (not blocked: the cost is known afterwards).
MAX_COST_PER_CLIP_USD=1.0
# Fallback cost estimate when a provider doesn't report cost (USD per million tokens).
# LLM_PRICE_INPUT_PER_MTOK=0.30
# LLM_PRICE_OUTPUT_PER_MTOK=2.50

# --- Comparing models only: extra models a caller may pick per upload (POST `model`, and a picker
# on /demo). Leave it unset in production: whoever can upload would choose what each clip costs.
# When set, `make fly-secrets` pushes it to Fly too; `make fly-choices-off` removes it there.
# LLM_MODEL_CHOICES=openai/gpt-5-nano,google/gemini-2.5-flash-lite,openai/gpt-5-mini,google/gemini-3-flash,anthropic/claude-haiku-4.5,anthropic/claude-sonnet-5.5

# --- Model call
# Some providers reject response_format=json_object; set false for those.
LLM_JSON_MODE=true
LLM_TIMEOUT_S=180
LLM_SEED=7

# --- Transcription (faster-whisper, runs locally on CPU, no cost). Options: tiny.en, base.en, small.en
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# --- HTTP Basic auth on every route but /health. Leave both unset locally; `make fly-secrets`
# requires them, because the Fly deployment is public. `make password` prints a random password line.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# --- Upload limits
MAX_UPLOAD_MB=200
MAX_DURATION_S=240

# --- Postgres (`make db` or docker compose). docker compose points the api at the db service itself.
DATABASE_URL=postgresql://clip:clip@localhost:5432/clip_scoring
# true: apply pending migrations on startup (zero setup). false: the service refuses to start
# until `make migrate` has run, so schema changes are applied deliberately.
AUTO_RUN_MIGRATIONS=true

# --- Uploads, Whisper model cache and temp work dirs (docker compose overrides it to /app/var)
DATA_DIR=var

# =============================================================================================
# ALTERNATIVE: local Ollama instead of the gateway (free, offline, uncalibrated scores)
# =============================================================================================
# Replace the REQUIRED block above with:
# LLM_BASE_URL=http://localhost:11434/v1
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=gemma3:latest
# LLM_VISION=true
# ~275 tokens per frame on gemma3: Ollama's default 4096-token context fits 6.
# Raise OLLAMA_CONTEXT_LENGTH (e.g. 8192) to use 16.
# LLM_MAX_FRAMES=6
