# Copy to .env and adjust:  cp example.env .env
# Never commit .env.

# --- Local development: Ollama (free, offline). gemma3 has vision, so frames are judged too.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:latest
LLM_VISION=true
# Frames sent to the judge (~275 tokens each on gemma3). Ollama's default 4096-token context
# fits 6; raise OLLAMA_CONTEXT_LENGTH (e.g. 8192) to use the default 16.
LLM_MAX_FRAMES=6

# --- Docker only: docker compose ignores LLM_BASE_URL above (localhost inside the container
# is the container itself) and uses this instead. Defaults to Ollama on the host.
# For the gateway under Docker, set it to https://ai-gateway.vercel.sh/v1
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Reported runs: Vercel AI Gateway (uncomment these and comment out the Ollama block)
# LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM_MODEL=google/gemini-2.5-flash
# AI_GATEWAY_API_KEY=your-gateway-key-here
# Fallback cost estimate when the gateway doesn't report cost (USD per million tokens)
# LLM_PRICE_INPUT_PER_MTOK=0.30
# LLM_PRICE_OUTPUT_PER_MTOK=2.50

# Some providers reject response_format=json_object; set false for those.
LLM_JSON_MODE=true
LLM_TIMEOUT_S=180
LLM_SEED=7

# Transcription (faster-whisper, CPU int8). Options: tiny.en, base.en, small.en
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# Upload limits
MAX_UPLOAD_MB=200
MAX_DURATION_S=240

# Postgres (docker compose up -d db). docker compose points the api at the db service itself.
DATABASE_URL=postgresql://clip:clip@localhost:5432/clip_scoring
# true: apply pending migrations on startup (zero setup). false: the service refuses to start
# until `make migrate` has run, so schema changes are applied deliberately.
AUTO_RUN_MIGRATIONS=true

# Uploads, Whisper model cache and temp work dirs (docker compose overrides it to /app/var)
DATA_DIR=var
